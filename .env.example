# ==============================================================================
# KubeGuardian AI – Cloud Native DevSecOps Platform Environment Configuration
# STRICT PROJECT ISOLATION: Configured with non-conflicting dedicated ports
# ==============================================================================

# Core Application Ports (Isolated from NextSight and default services)
KUBEGUARDIAN_CLIENT_PORT=3000
KUBEGUARDIAN_SERVER_PORT=8000
KUBEGUARDIAN_MONGO_PORT=27018
KUBEGUARDIAN_REDIS_PORT=6389
KUBEGUARDIAN_PROMETHEUS_PORT=9091
KUBEGUARDIAN_GRAFANA_PORT=3001

# Server Settings
NODE_ENV=development
PORT=8000
JWT_SECRET=kubeguardian-devsecops-super-secure-jwt-key
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Database Settings (Dedicated KubeGuardian MongoDB instance)
MONGODB_URI=mongodb://localhost:27018/kubeguardian
REDIS_URL=redis://localhost:6389

# AI Integration
# Leave blank to use KubeGuardian's internal AI DevSecOps Reasoning Engine
OPENAI_API_KEY=

# Kubernetes Integration
# Optional path to a disposable Kind/Minikube cluster kubeconfig.
# If omitted or unreadable, KubeGuardian operates in Safe Isolated Virtual Cluster mode.
KUBECONFIG_PATH=
